/* ============================================================
   Mahmoud AI Global Tool Ultimate 2026
   Dark Theme Stylesheet
   ============================================================ */

/* ── Global ────────────────────────────────────────────────── */
* {
    font-family: "Segoe UI", "Cairo", "Noto Sans Arabic", Arial, sans-serif;
    color: #E2E8F0;
    outline: none;
}

QMainWindow, QWidget#centralWidget {
    background-color: #0D1117;
}

/* ── Sidebar ────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #161B22;
    border-right: 1px solid #21262D;
    min-width: 220px;
    max-width: 220px;
}

QWidget#sidebar QPushButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #8B949E;
    text-align: left;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 500;
}

QWidget#sidebar QPushButton:hover {
    background-color: #21262D;
    color: #E2E8F0;
}

QWidget#sidebar QPushButton[active="true"] {
    background-color: #1F6FEB20;
    color: #58A6FF;
    border-left: 3px solid #1F6FEB;
}

/* ── Content Area ───────────────────────────────────────────── */
QWidget#contentArea {
    background-color: #0D1117;
}

QStackedWidget {
    background-color: #0D1117;
}

/* ── Cards ──────────────────────────────────────────────────── */
QFrame#card {
    background-color: #161B22;
    border: 1px solid #21262D;
    border-radius: 12px;
    padding: 16px;
}

QFrame#card:hover {
    border-color: #1F6FEB;
}

QFrame#statusCard {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #161B22,
        stop:1 #1F2937
    );
    border: 1px solid #1F6FEB40;
    border-radius: 12px;
    padding: 20px;
}

/* ── Headers / Labels ──────────────────────────────────────── */
QLabel#pageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #E2E8F0;
    padding-bottom: 4px;
}

QLabel#sectionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #58A6FF;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QLabel#infoKey {
    font-size: 12px;
    color: #8B949E;
}

QLabel#infoValue {
    font-size: 13px;
    font-weight: 600;
    color: #E2E8F0;
}

QLabel#deviceModel {
    font-size: 18px;
    font-weight: 700;
    color: #58A6FF;
}

QLabel#statusBadge {
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#statusBadge[status="connected"] {
    background-color: #238636;
    color: #AAFFAA;
}

QLabel#statusBadge[status="disconnected"] {
    background-color: #6E768144;
    color: #8B949E;
}

QLabel#statusBadge[status="rooted"] {
    background-color: #DA363344;
    color: #FF7B72;
}

/* ── Buttons ────────────────────────────────────────────────── */
QPushButton {
    background-color: #21262D;
    border: 1px solid #30363D;
    border-radius: 8px;
    color: #C9D1D9;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #30363D;
    border-color: #8B949E;
    color: #E2E8F0;
}

QPushButton:pressed {
    background-color: #161B22;
}

QPushButton:disabled {
    color: #484F58;
    border-color: #21262D;
    background-color: #161B22;
}

QPushButton#primaryBtn {
    background-color: #1F6FEB;
    border-color: #1F6FEB;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#primaryBtn:hover {
    background-color: #388BFD;
    border-color: #388BFD;
}

QPushButton#dangerBtn {
    background-color: #DA363344;
    border-color: #F85149;
    color: #FF7B72;
}

QPushButton#dangerBtn:hover {
    background-color: #DA3633;
    color: #FFFFFF;
}

QPushButton#successBtn {
    background-color: #23863644;
    border-color: #3FB950;
    color: #56D364;
}

QPushButton#successBtn:hover {
    background-color: #238636;
    color: #FFFFFF;
}

QPushButton#warningBtn {
    background-color: #BB800944;
    border-color: #D29922;
    color: #E3B341;
}

/* ── Input Fields ───────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 8px;
    color: #E2E8F0;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #1F6FEB;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #1F6FEB;
}

QLineEdit::placeholder, QTextEdit::placeholder {
    color: #484F58;
}

/* ── ComboBox ───────────────────────────────────────────────── */
QComboBox {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 8px;
    color: #E2E8F0;
    padding: 7px 12px;
    font-size: 13px;
    min-width: 120px;
}

QComboBox:hover { border-color: #8B949E; }
QComboBox:focus { border-color: #1F6FEB; }

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #8B949E;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 8px;
    color: #E2E8F0;
    selection-background-color: #1F6FEB;
}

/* ── Tables ─────────────────────────────────────────────────── */
QTableWidget {
    background-color: #0D1117;
    border: 1px solid #21262D;
    border-radius: 8px;
    gridline-color: #21262D;
    color: #E2E8F0;
    alternate-background-color: #161B22;
    font-size: 12px;
}

QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #21262D;
}

QTableWidget::item:selected {
    background-color: #1F6FEB33;
    color: #58A6FF;
}

QHeaderView::section {
    background-color: #161B22;
    color: #8B949E;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 8px 10px;
    border-bottom: 1px solid #21262D;
    border-right: 1px solid #21262D;
}

/* ── List Widget ────────────────────────────────────────────── */
QListWidget {
    background-color: #161B22;
    border: 1px solid #21262D;
    border-radius: 8px;
    color: #E2E8F0;
    font-size: 13px;
    padding: 4px;
}

QListWidget::item {
    padding: 8px 12px;
    border-radius: 6px;
}

QListWidget::item:hover { background-color: #21262D; }
QListWidget::item:selected {
    background-color: #1F6FEB33;
    color: #58A6FF;
}

/* ── Progress Bar ───────────────────────────────────────────── */
QProgressBar {
    background-color: #21262D;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    font-size: 11px;
    color: transparent;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #1F6FEB,
        stop:1 #58A6FF
    );
    border-radius: 4px;
}

/* ── Scroll Bars ────────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: #0D1117;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #30363D;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover { background-color: #8B949E; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background-color: #0D1117;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #30363D;
    border-radius: 4px;
    min-width: 20px;
}

/* ── Tabs ───────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #21262D;
    border-radius: 8px;
    background-color: #161B22;
}

QTabBar::tab {
    background-color: #0D1117;
    color: #8B949E;
    border-bottom: 2px solid transparent;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
}

QTabBar::tab:hover  { color: #E2E8F0; }
QTabBar::tab:selected {
    color: #58A6FF;
    border-bottom: 2px solid #1F6FEB;
    background-color: #161B22;
}

/* ── CheckBox ───────────────────────────────────────────────── */
QCheckBox {
    color: #E2E8F0;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #30363D;
    border-radius: 4px;
    background-color: #161B22;
}

QCheckBox::indicator:checked {
    background-color: #1F6FEB;
    border-color: #1F6FEB;
    image: none;
}

/* ── Group Box ──────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #21262D;
    border-radius: 10px;
    margin-top: 16px;
    padding-top: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #58A6FF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background-color: #0D1117;
}

/* ── Splitter ───────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #21262D;
    width: 2px;
    height: 2px;
}

/* ── Status Bar ─────────────────────────────────────────────── */
QStatusBar {
    background-color: #161B22;
    border-top: 1px solid #21262D;
    color: #8B949E;
    font-size: 12px;
}

/* ── ToolTip ────────────────────────────────────────────────── */
QToolTip {
    background-color: #21262D;
    color: #E2E8F0;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Separator ──────────────────────────────────────────────── */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #21262D;
}

/* ── Log Area ───────────────────────────────────────────────── */
QPlainTextEdit#logViewer {
    background-color: #010409;
    border: 1px solid #21262D;
    border-radius: 8px;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 12px;
    color: #3FB950;
    padding: 8px;
}
